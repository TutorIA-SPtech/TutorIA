{
  "expo": {
    "name": "TutorIA",
    "slug": "TutorIA",
    "scheme": "tutoriaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tuti.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.sptech.tutoria",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sptech.tutoria",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40a3c062-4652-4513-b1d9-a136365c7379"
      }
    }
  }
}
